# ==============================================================================
# VulnScan - Backend Environment Template (backend/.env.example)
# Copy to backend/.env and adjust variables as needed
# ==============================================================================

# Server Network Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection
DATABASE_URL=postgresql://vulnscan:vulnscan_password@localhost:5432/vulnscan?schema=public

# Redis Connection
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=vulnscan_dev_jwt_secret_change_in_production_key_12345

# Scanner Workspace Directory
WORKSPACE_DIR=./tmp/scans

# GitHub Personal Access Token (Optional: for private repositories or higher rate limits)
GITHUB_TOKEN=

# Local AI Verification Engine (Ollama / Qwen 2.5 Coder 1.5B)
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_MODEL=qwen2.5-coder:1.5b
AI_VALIDATION_ENABLED=true
