# ==============================================================================
# VulnScan - Root Environment Template (.env.example)
# Copy to .env and adjust variables as needed
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database (Docker Service: vulnscan-db)
# ------------------------------------------------------------------------------
POSTGRES_USER=vulnscan
POSTGRES_PASSWORD=vulnscan_password
POSTGRES_DB=vulnscan
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Redis Cache & Queue (Docker Service: vulnscan-redis)
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Backend Service Configuration (Node.js API)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://vulnscan:vulnscan_password@localhost:5432/vulnscan?schema=public
JWT_SECRET=vulnscan_dev_jwt_secret_change_in_production_key_12345
WORKSPACE_DIR=./tmp/scans

# GitHub Personal Access Token (Optional: for private repos & higher rate limits)
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# Frontend Application (Vite + React)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# Local AI Verification Engine (Ollama / Qwen 2.5 Coder)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_MODEL=qwen2.5-coder:1.5b
AI_VALIDATION_ENABLED=true
