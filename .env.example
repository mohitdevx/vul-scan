# ==========================================
# VulnScan Environment Variables (.env.example)
# ==========================================

# Backend Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (SQLite for local dev, PostgreSQL in Docker)
DATABASE_URL="file:./dev.db"

# PostgreSQL Configuration (for Docker Compose)
POSTGRES_USER=vulnscan
POSTGRES_PASSWORD=vulnscan_password
POSTGRES_DB=vulnscan_db
POSTGRES_PORT=5432

# Redis Configuration (for Docker Compose & Job Caching)
REDIS_URL="redis://localhost:6379"
REDIS_PORT=6379

# Authentication
JWT_SECRET="vulnscan_dev_jwt_secret_change_in_production_key_12345"

# Scanner Engine Directory
WORKSPACE_DIR=./tmp/scans

# GitHub API Integration (Optional / Mock default)
GITHUB_TOKEN=ghp_exampleTemporaryGithubTokenForPublicRepos123456789

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:4000
