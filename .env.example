# ==========================================
# VulnScan Environment Variables (.env.example)
# ==========================================

# Backend Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (Prisma SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Authentication
JWT_SECRET="vulnscan_dev_jwt_secret_change_in_production_key_12345"

# Scanner Engine Directory
WORKSPACE_DIR=./tmp/scans

# GitHub API Integration (Optional / Mock default)
# Provide your GitHub Personal Access Token for higher rate limits if scanning private or large public repos
GITHUB_TOKEN=ghp_exampleTemporaryGithubTokenForPublicRepos123456789

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:4000
